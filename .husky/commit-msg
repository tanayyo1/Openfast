#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

set -eu

# Get the commit message
COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Check if commit message follows the format: ISSUE-XXX: Description
if ! echo "$COMMIT_MSG" | grep -Eq '^(LIN|RED|OAK)-[0-9]+: .+'; then
  echo "ERROR: Commit message format is invalid!"
  echo ""
  echo "Expected format: ISSUE-XXX: Brief description"
  echo "Examples:"
  echo "  OAK-123: Add scheduler service for delayed posts"
  echo "  RED-58: Add landing page generator"
  echo "  LIN-84: Wire opportunities page to live APIs"
  echo ""
  echo "Your message:"
  echo "$COMMIT_MSG"
  echo ""
  echo "Fix your commit message and try again."
  exit 1
fi

echo "Commit message format is valid"
