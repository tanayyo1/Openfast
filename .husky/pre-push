#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🚫 Checking push restrictions..."

# Get current branch
BRANCH_NAME=$(git symbolic-ref --short HEAD)

# Prevent pushing to main or develop directly
if [ "$BRANCH_NAME" = "main" ] || [ "$BRANCH_NAME" = "develop" ]; then
  echo "❌ ERROR: Direct push to $BRANCH_NAME branch is forbidden!"
  echo ""
  echo "Use the proper workflow:"
  echo "1. Create a feature branch: git checkout -b feature/OAK-XXX-description"
  echo "2. Make your changes"
  echo "3. Push the feature branch: git push origin feature/OAK-XXX-description"
  echo "4. Create a Pull Request"
  echo "5. Get it reviewed and merged"
  echo ""
  exit 1
fi

echo "✅ Push allowed to branch: $BRANCH_NAME"
