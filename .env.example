# =============================================================================
# DATABASE CONFIGURATION (Hybrid Setup)
# =============================================================================
# We use a HYBRID database architecture:
# - Development: Local PostgreSQL (fast, offline-capable)
# - Production: Supabase Postgres (scalable, managed)
#
# For development (default):
DATABASE_URL="postgresql://user:password@localhost:5432/reditfast"
DIRECT_URL="postgresql://user:password@localhost:5432/reditfast"
#
# For production (copy to .env.production):
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:5432/postgres"
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
# Get these from: Supabase Dashboard → Project Settings → Database
# =============================================================================

# Redis
REDIS_URL="redis://localhost:6379"

# Reddit OAuth
# Create app at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID="your_reddit_client_id"
REDDIT_CLIENT_SECRET="your_reddit_client_secret"
REDDIT_REDIRECT_URI="http://localhost:3000/api/reddit/oauth/callback"

# Token encryption (required for storing Reddit OAuth tokens)
# Generate a key with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEYS="v1:replace_with_base64_32_byte_key"

# OpenAI
OPENAI_API_KEY="sk-your_openai_key"

# Reddit Ads external sync (RED-52 follow-up)
# Use "mock" for local/dev without a provider.
REDDIT_ADS_SYNC_MODE="mock"
# Webhook provider endpoint (required only when REDDIT_ADS_SYNC_MODE="webhook")
REDDIT_ADS_SYNC_ENDPOINT=""
REDDIT_ADS_SYNC_API_KEY=""
REDDIT_ADS_SYNC_TIMEOUT_MS="10000"

# Polar (billing provider)
POLAR_ACCESS_TOKEN="polar_at_your_token_here"
POLAR_WEBHOOK_SECRET="your_polar_webhook_secret"
POLAR_PRODUCT_PRO="product-uuid-for-pro"
POLAR_PRODUCT_ENTERPRISE="product-uuid-for-enterprise"
POLAR_SERVER="production"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_random_secret_key_min_32_chars"

# Email (Resend)
RESEND_API_KEY="re_your_resend_key"
RESEND_FROM_EMAIL="noreply@reditfast.com"

# App
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Optional: Analytics
SENTRY_DSN=""
POSTHOG_KEY=""
POSTHOG_HOST=""

# Optional: Cloudflare R2 (for media storage)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# =============================================================================
# SUPABASE AUTH (Required)
# =============================================================================
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
#
# For server-side operations (service role key - keep secret!)
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# =============================================================================

# Linear MCP (Model Context Protocol) - AI Integration
# Get your API key from: Linear → Settings → API → Personal API keys
LINEAR_API_KEY="lin_api_your_key_here"
LINEAR_MCP_SERVER_URL="https://mcp.linear.app"
