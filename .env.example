# Database
DATABASE_URL="postgresql://user:password@localhost:5432/reditfast"
DIRECT_URL="postgresql://user:password@localhost:5432/reditfast"

# Redis
REDIS_URL="redis://localhost:6379"

# Reddit OAuth
# Create app at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID="your_reddit_client_id"
REDDIT_CLIENT_SECRET="your_reddit_client_secret"
REDDIT_REDIRECT_URI="http://localhost:3000/api/auth/callback/reddit"

# OpenAI
OPENAI_API_KEY="sk-your_openai_key"

# Stripe
STRIPE_SECRET_KEY="sk_test_your_stripe_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_random_secret_key_min_32_chars"

# Email (Resend)
RESEND_API_KEY="re_your_resend_key"
RESEND_FROM_EMAIL="noreply@reditfast.com"

# App
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Optional: Analytics
SENTRY_DSN=""
POSTHOG_KEY=""
POSTHOG_HOST=""

# Optional: Cloudflare R2 (for media storage)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Linear MCP (Model Context Protocol) - AI Integration
# Get your API key from: Linear → Settings → API → Personal API keys
LINEAR_API_KEY="lin_api_your_key_here"
LINEAR_MCP_SERVER_URL="https://mcp.linear.app"
